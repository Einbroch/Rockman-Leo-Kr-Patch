@archive 0018
@size 30

script 0 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = PegasusMagic
	"""
	スターフォースの力、
	たたかいの前に すこし
	せつめい しておこう
	"""
	keyWait
		type = 1
	clearMsg
	"""
	へんしん中は カスタム画面で
	バトルカードを えらぶときの
	じょうけんが ふえる
	"""
	keyWait
		type = 1
	clearMsg
	"""
	たてならび だけでなく
	なんと よこならびでも
	いっしょに えらぶことができるぞ
	"""
	keyWait
		type = 1
	clearMsg
	"""
	さらに チャージショットが
	敵を こおらせてしまう
	アイススラッシャーに なるぞ
	"""
	keyWait
		type = 1
	clearMsg
	"""
	そして SFB・・・
	スターフォースビッグバンについて
	せつめいしておこう
	"""
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = IcePegasusMegaMan
	"スターフォースビッグバン?"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = PegasusMagic
	"""
	サテライトのもつ パワーを
	だいばくはつさせて 攻撃する
	ひっさつわざだ
	"""
	keyWait
		type = 1
	clearMsg
	"""
	SFBを つかうには
	まず カウンターをとらねば
	ならない
	"""
	keyWait
		type = 1
	clearMsg
	"""
	ふだんなら ボーナスカードが
	出てくるところが
	"""
	keyWait
		type = 1
	clearMsg
	"""
	スターフォースでへんしん中は
	SFBのバトルカードが
	しゅつげんするのだ
	"""
	keyWait
		type = 1
	clearMsg
	"""
	あとは いつもどおりに
	Aボタンで つかえば
	SFBが はつどうする!
	"""
	keyWait
		type = 1
	clearMsg
	"""
	ムリにねらうことはないが
	SFBは ひっさつのハカイリョク
	"""
	keyWait
		type = 1
	clearMsg
	"""
	つかいこなせば
	大きな力となるだろう
	おぼえておくがよい
	"""
	keyWait
		type = 1
	clearMsg
	"""
	まずは 目の前の敵をたおすことに
	しゅうちゅうするがよい
	"""
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = IcePegasusMegaMan
	"""
	うん、わかったよ
	よーし、いくぞ!
	"""
	keyWait
		type = 0
	end
	end
}
