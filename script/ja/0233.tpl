	こうして、こんかいのじけんは
	かいけつした
	"""
	keyWait
		type = 1
	clearMsg
	"""
	じけんご、すぐに そうどうの
	げんいんきゅうめいが
	おこなわれたけど・・・
	"""
	keyWait
		type = 1
	clearMsg
	"""
	けっきょく、がくしゅう電波の
	そうさを 育田先生が
	あやまったから、とはんだんされた
	"""
	keyWait
		type = 1
	clearMsg
	"""
	それをうけて、
	がくしゅう電波の しようは
	みなおされることになった
	"""
	keyWait
		type = 1
	clearMsg
	"""
	そして、育田先生は
	というと・・・
	"""
	keyWait
		type = 1
	clearMsg
	end
}
