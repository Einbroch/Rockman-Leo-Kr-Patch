script 80 mmsf1 {
	msgOpenQuick
	textSpeed
		delay = 0
	"""
	トランサーの メモリの中に
	なにか テキストデータが
	はいっている・・・
	"""
	keyWait
		type = 1
	clearMsg
	"「"
	printPlayerName2
	"へ・・・\n おまえが このデータを\n よむころ、"
	keyWait
		type = 1
	clearMsg
	" 父さんは うちゅうを\n さまよって いるかもしれない"
	keyWait
		type = 1
	clearMsg
	" 父さんは、うちゅう人\n ウォーロックの チカラをかりて\n 電波体になった"
	keyWait
		type = 1
	clearMsg
	" このさき、生きて おまえに\n あえるかどうか わからないし、"
	keyWait
		type = 1
	clearMsg
	" はてしない うちゅうくうかんを\n えいえんに さまようことに\n なるかもしれない"
	keyWait
		type = 1
	clearMsg
	" だが、さみしがるコトはない\n どんなに はなれていても、"
	keyWait
		type = 1
	clearMsg
	" オレたち かぞくのココロは\n つながっている"
	keyWait
		type = 1
	clearMsg
	" つらい時、かなしい時は\n よぞらを 見上げて\n 父さんを おもいだせ"
	keyWait
		type = 1
	clearMsg
	" 父さんは いつも見まもっている"
	keyWait
		type = 1
	clearMsg
	" "
	printPlayerName2
	"、\n かあさんを よろしくたのんだぞ"
	keyWait
		type = 1
	clearMsg
	" あ、それと、ウォーロックという\n うちゅう人が そっちに行ったら"
	keyWait
		type = 1
	clearMsg
	" このトランサーにくみこんである\n ウォーロックの ぶきを\n わたしてやってくれ」"
	waitHold
	end
}
