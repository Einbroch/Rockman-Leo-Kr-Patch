		type = 1
	clearMsg
	"""
	あの ワッカは
	なんなの だろう?
	"""
	keyWait
		type = 1
	clearMsg
	"ドーナツで あろうか?"
	keyWait
		type = 1
	clearMsg
	"""
	ドーナツで あれば
	あれだけの コムギコを
	ようい しなければ ならない
	"""
	keyWait
		type = 1
	clearMsg
	"""
	また ドーナツで あるのならば
	ショウミキゲン までに
	めしあがる ひつようが ある
	"""
	keyWait
		type = 1
	clearMsg
	"!"
	keyWait
		type = 1
	clearMsg
	"""
	なんだって? これだけの
	サイズの ドーナツなど
	たべられる はずが ない!
	"""
	keyWait
		type = 1
	clearMsg
	"むむむ・・・"
	keyWait
		type = 1
	clearMsg
	"""
	どれほどの ナビを
	あつめれば あの ドーナツを
	たべきれるので あろうか・・・
	"""
	keyWait
		type = 0
	end
	end
}
