		type = 1
	clearMsg
	"""
	しかし、じんるいの ユメをのせた
	うちゅうステーションは
	"""
	keyWait
		type = 1
	clearMsg
	"""
	げんいんふめいの
	じこにそうぐうし、
	そのゆくえをたってしまった・・・
	"""
	keyWait
		type = 0
	end
	end
}
script 2 mmsf1 {
	msgOpen
	"""
	ひっしの そうさくにも
	かかわらず、
	"""
