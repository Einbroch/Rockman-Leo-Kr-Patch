@archive 0103
@size 3

script 0 mmsf1 {
	msgOpen
	"220X年・・・"
	keyWait
		type = 1
	clearMsg
	"""
	うちゅうに ちきゅうがい
	せいめいたいを 見つけた
	"""
	keyWait
		type = 1
	clearMsg
	"""
	ニホンうちゅうかがくきょく
	NAXA(ナクサ)は、
	"""
	keyWait
		type = 1
	clearMsg
	"""
	みちなる せいめいたいと
	ゆうこうの かんけい、
	「ブラザーバンド」を むすぼうと
	"""
	keyWait
		type = 1
	clearMsg
	"""
	うちゅうステーション、
	「きずな」を うちあげた・・・
	"""
	keyWait
		type = 0
	end
	end
}
script 1 mmsf1 {
	msgOpen
	"""
	じんるいが ユメに見た
