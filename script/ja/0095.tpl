	セレクトボタンで
	トランサーの 画面を
	きりかえることができ、
	"""
	keyWait
		type = 1
	clearMsg
	"""
	パーソナルカード、
	ブラザーカード
	"""
	keyWait
		type = 1
	clearMsg
	"""
	ナビカードなどを
	ひょうじすることができます
	"""
	keyWait
		type = 1
	clearMsg
	"""
	トランサー画面に
	ナビカードが でているときは
	"""
	keyWait
		type = 1
	clearMsg
	"""
	そのナビが トランサーの
	中にいるというコトです
	"""
	keyWait
		type = 1
	clearMsg
	"""
	トランサーに ナビカードを
	さしていると、
	"""
	keyWait
		type = 1
	clearMsg
	"""
	おもわぬチカラを
	はっきしてくれることも
	あります
	"""
	keyWait
		type = 1
	clearMsg
	"""
	かれらは アナタの
	たよれるパートナーです
	"""
	keyWait
		type = 1
	clearMsg
	"""
	Lボタンで はなしかけたりして
	かわいがってあげましょう
	"""
	keyWait
		type = 1
	clearMsg
	"""
	さいごに、すべてのトランサーは
	うちゅうに うかぶ
	3つの サテライト・・・
	"""
	keyWait
		type = 1
	clearMsg
