	電気属性の攻撃を くらうと
	2ばいの ダメージをうけるうえ
	へんしんが とけてしまうのだ
	"""
	keyWait
		type = 1
	clearMsg
	"""
	また へんしん中は
	カスタム画面で
	バトルカードを えらぶとき
	"""
	keyWait
		type = 1
	clearMsg
	"""
	たてならび だけでなく
	よこならびの カードどうしでも
	えらぶことが できるようになるぞ
	"""
	keyWait
		type = 1
	clearMsg
	"""
	そして もうひとつ、
	カウンターをとったとき ふつうは
	ボーナスカードが あらわれるが
	"""
	keyWait
		type = 1
	clearMsg
	"""
	へんしん中は SFB・・・
	スターフォースビッグバンの
	バトルカードが しゅつげんする
	"""
	keyWait
		type = 1
	clearMsg
	"""
	アイスペガサスの SFBは
	マジシャンズフリーズ!
	"""
	keyWait
		type = 1
	clearMsg
	"""
	きょだいな まほうじんから
	こおりのはしらが とびだし
	敵をこおりつかせるぞ!
	"""
	keyWait
		type = 1
	clearMsg
	"""
	ペガサスの スターフォースを
	そなたが みごとに
	つかいこなし
	"""
	keyWait
		type = 1
	clearMsg
	"""
	だいじな人を まもる
	チカラと なることを
	いのっておるぞ
	"""
	keyWait
		type = 2
	waitHold
	end
}
