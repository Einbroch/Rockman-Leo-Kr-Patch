script 0 mmsf1 {
	msgOpenQuick
	mugshotHide
	textSpeed
		delay = 3
	"""
	こんしゅうは、トランサーについて
	べんきょうしていきましょう
	"""
	keyWait
		type = 1
	clearMsg
