	でんわや メールキノウをはじめ、
	みなさんの こじんじょうほうが
	つまった パーソナルページなど、
	"""
	keyWait
		type = 1
	clearMsg
	"""
	さまざまな キノウが
	つまっています
	"""
	keyWait
		type = 1
	clearMsg
