	clearMsg
	"""
	そのブラザーの しょぞくする
	スターフォースの パワーを
	せんたくすることも できるぞ
	"""
	keyWait
		type = 1
	clearMsg
	"""
	ロックマン・アイスペガサス は
	水属性のパワーを もっておる
	"""
	keyWait
		type = 1
	clearMsg
	"""
	タメうちが 敵をこおらせる
	アイススラッシュに なるが
	そのかわりに
	"""
	keyWait
		type = 1
	clearMsg
