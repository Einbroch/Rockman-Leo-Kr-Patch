@archive 0459
@size 256

script 0 mmsf1 {
	msgOpen
	"신발장이다."
	keyWait
		type = 1
	clearMsg
	"기분 좋은 둥글둥글한\n디자인이네.\n"
	keyWait
		type = 0
	end
	end
}
script 1 mmsf1 {
	msgOpen
	"바쁜 집주인을 위한\n믿음직한 VX-01 청소 로봇이다.\n"
	keyWait
		type = 1
	clearMsg
	"슬로건은 \"플라스마 파워로\n먼지와 작별하세요!\"다.\n"
	keyWait
		type = 0
	end
	end
}
script 2 mmsf1 {
	msgOpen
	"여기 꽃병에 일렉토피아산\n꽃이 꽂혀 있다.\n"
	keyWait
		type = 1
	clearMsg
	"스컹크 캐비지라는\n꽃인데,\n"
	keyWait
		type = 1
	clearMsg
	"\"아름다운 추억\"을\n상징한다고 한다.\n"
	keyWait
		type = 0
	end
	end
}
script 3 mmsf1 {
	msgOpen
	"늘 쓰는 찻잔 세트가\n꺼내져 있다.\n"
	keyWait
		type = 1
	clearMsg
	"이 세트는 해외에서만\n살 수 있다고 들었다...\n"
	keyWait
		type = 0
	end
	end
}
script 4 mmsf1 {
	msgOpen
	"안에는 예쁜 식기들이 가지런히\n정리되어 있다.\n"
	keyWait
		type = 0
	end
	end
}
script 5 mmsf1 {
	msgOpen
	"주방의 모든 일을 컴퓨터가\n처리하고 있어서\n"
	keyWait
		type = 1
	clearMsg
	"직접 요리하는 건 사실상\n불가능하다.\n"
	keyWait
		type = 0
	end
	end
}
script 7 mmsf1 {
	msgOpen
	"바로 밖에는\n정말 잘 가꿔진 화단이\n있다."
	keyWait
		type = 0
	end
	end
}
script 8 mmsf1 {
	msgOpen
	"엄청나게 얇은 TV다.\n\n"
	keyWait
		type = 1
	clearMsg
	"옛날 사람들이 보면\n깜짝 놀라겠지만, 지금은 아니다.\n"
	keyWait
		type = 0
	end
	end
}
script 9 mmsf1 {
	msgOpen
	"우주복을 입은\n건장한 남자의\n사진과"
	keyWait
		type = 1
	clearMsg
	"그 남자와 가족이 나란히 선\n사진이 여기 있다...\n"
	keyWait
		type = 0
	end
	end
}
script 10 mmsf1 {
	msgOpen
	"장식용 화분이다.\n\n"
	keyWait
		type = 1
	clearMsg
	"엄마가 물과 영양분을\n듬뿍 주고 있다.\n"
	keyWait
		type = 0
	end
	end
}
script 11 mmsf1 {
	msgOpen
	"이 방의 온도를 조절하는\n패널이다.\n"
	keyWait
		type = 0
	end
	end
}
script 12 mmsf1 {
	msgOpen
	"대형 스피커다."
	keyWait
		type = 1
	clearMsg
	"TV 화면이\n생생하게 살아나는 건\n"
	keyWait
		type = 1
	clearMsg
	"이 거대한 스피커들\n덕분이다."
	keyWait
		type = 0
	end
	end
}
script 20 mmsf1 {
	msgOpen
	"냉장고 안이 신선한 식재료로\n가득 차 있다.\n"
	keyWait
		type = 0
	end
	end
}
script 21 mmsf1 {
	msgOpen
	"냉장고 안이 신선한 식재료로\n가득 차 있다.\n"
	keyWait
		type = 1
	clearMsg
	"...응?"
	keyWait
		type = 1
	clearMsg
	"자세히 보면, 여기에\n웨이브 홀이 있어!\n"
	keyWait
		type = 2
	flagSet
		flag = 116
	end
}
script 22 mmsf1 {
	msgOpen
	"냉장고 안이 신선한 식재료로\n가득 차 있다.\n"
	keyWait
		type = 0
	end
	end
}
