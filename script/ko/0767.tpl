@archive 0767
@size 256

script 0 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = MrHertz
	"*삐 삐*"
	keyWait
		type = 1
	clearMsg
	"안녕, 아저씨!"
	keyWait
		type = 1
	clearMsg
	"내가 멋진 녀석 같지 않아?\n"
	keyWait
		type = 1
	clearMsg
	"아저씨, 모든 일이\n순조로운가요?\n"
	keyWait
		type = 1
	clearMsg
	"*삐 삐*"
	keyWait
		type = 1
	clearMsg
	"내가 여기서 뭘 하고 있냐고?\n"
	keyWait
		type = 1
	clearMsg
	"모르겠어?\n"
	keyWait
		type = 1
	clearMsg
	"그럼 잠깐 쉬면서\n내 얘기를 들어 봐.\n"
	keyWait
		type = 1
	clearMsg
	"내 가방이 이 음료들을\n시원하게 보관해 주고 있지.\n"
	keyWait
		type = 1
	clearMsg
	"끝내주지 않아?"
	keyWait
		type = 1
	clearMsg
	"꼬맹아, 이런 걸 알려\n주지...\n"
	keyWait
		type = 1
	clearMsg
	"나는 최고의\n쿨가이야.\n"
	keyWait
		type = 1
	clearMsg
	"너무 가까이 오지 마,\n"
	keyWait
		type = 1
	clearMsg
	"얼어 버릴지도 모르니까!\n"
	keyWait
		type = 1
	clearMsg
	"*삐 삐*"
	keyWait
		type = 0
	end
	end
}
