@archive 0018
@size 30

script 0 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = PegasusMagicShadow
	"배틀에서 스타\n포스를 사용하기 전에,\n"
	keyWait
		type = 1
	clearMsg
	"설명해 드리겠습니다. 변신한\n상태에서는\n"
	keyWait
		type = 1
	clearMsg
	"고를 수 있는 카드의\n수가 늘어납니다.\n"
	keyWait
		type = 1
	clearMsg
	"이제 같은 열의 카드만\n고를 수 있는 게 아니라,\n"
	keyWait
		type = 1
	clearMsg
	"같은 행의 카드도\n고를 수 있습니다.\n"
	keyWait
		type = 1
	clearMsg
	"또 차지 샷으로\n적을 얼릴 수 있습니다.\n"
	keyWait
		type = 1
	clearMsg
	"아이스 슬래시라는\n공격입니다.\n"
	keyWait
		type = 1
	clearMsg
	"마지막으로 스타 포스\n빅뱅, 줄여서 SFB입니다.\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = IcePegasusMegaMan
	"스타 포스 빅뱅?\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = PegasusMagicShadow
	"제 위성의 힘을\n이용한 강력한 공격입니다.\n"
	keyWait
		type = 1
	clearMsg
	"SFB를 사용하려면\n먼저 카운터를\n"
	keyWait
		type = 1
	clearMsg
	"성공시켜야\n합니다.\n"
	keyWait
		type = 1
	clearMsg
	"그때 나오는\n어펜드 카드가\n변화하여"
	keyWait
		type = 1
	clearMsg
	"SFB 배틀 카드로\n변합니다. 단,\n"
	keyWait
		type = 1
	clearMsg
	"스타 포스 폼을\n유지하고 있을 때만 가능합니다.\n"
	keyWait
		type = 1
	clearMsg
	"A 버튼을 누르기만 하면\n"
	keyWait
		type = 1
	clearMsg
	"SFB가 적을 향해\n내려찍습니다.\n"
	keyWait
		type = 1
	clearMsg
	"SFB는 무시무시한\n위력을 지녔으니,\n"
	keyWait
		type = 1
	clearMsg
	"가능할 때는 꼭\n얻어 두도록 하세요.\n"
	keyWait
		type = 1
	clearMsg
	"현명하게 사용하면\n큰 도움이 될 겁니다.\n"
	keyWait
		type = 1
	clearMsg
	"내가 말한 내용을\n기억하세요.\n"
	keyWait
		type = 1
	clearMsg
	"이제 눈앞의 적에게\n집중하세요.\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = IcePegasusMegaMan
	"알겠어! 좋아, 가자!\n"
	keyWait
		type = 0
	end
	end
}
