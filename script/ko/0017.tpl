@archive 0017
@size 12

script 0 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = OmegaXis
	"마지막으로 하나\n더... 카운터와 어펜드\n카드야."
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = MegaMan
	"음, 하나씩 설명해 주면\n안 될까?\n"
	keyWait
		type = 1
	clearMsg
	"먼저, 카운터가 뭐야?\n\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = OmegaXis
	"*한숨* 카운터는 네 카드 공격이\n적이\n"
	keyWait
		type = 1
	clearMsg
	"너를 공격하려는 바로 그 순간\n적에게 명중하는 거야.\n"
	keyWait
		type = 1
	clearMsg
	"적이 공격을 시작하는 순간\n말이지.\n"
	keyWait
		type = 1
	clearMsg
	"그러면 네 공격이\n적을 잠시 스턴시켜.\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = MegaMan
	"조금 어려운 것 같지만, 이제\n카운터가 뭔지 알겠어.\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = OmegaXis
	"아니, 카운터를 하면\n적을 스턴시키기만 하는\n게 아니야."
	keyWait
		type = 1
	clearMsg
	"어펜드 카드도 1장 얻지.\n\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = MegaMan
	"어펜드 카드?"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = OmegaXis
	"평소에는 커스텀 화면에서\n고른\n"
	keyWait
		type = 1
	clearMsg
	"카드만 사용할 수 있다는\n거 알고 있지?\n"
	keyWait
		type = 1
	clearMsg
	"하지만 카운터에 성공하면\n어펜드 카드를 얻을 수 있어.\n"
	keyWait
		type = 1
	clearMsg
	"어펜드 카드는 무작위지만,\n이렇게 하면\n"
	keyWait
		type = 1
	clearMsg
	"커스텀 게이지가\n차오를 때까지 기다리지 않고\n"
	keyWait
		type = 1
	clearMsg
	"적을 해치울\n수 있어.\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = MegaMan
	"그렇구나...\n이제 알 것 같아.\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = OmegaXis
	"카운터는 타이밍을 맞추기\n어려우니까,"
	keyWait
		type = 1
	clearMsg
	"어펜드 카드를 얻겠다고 무리해서\n운을 시험하진 마.\n"
	keyWait
		type = 1
	clearMsg
	"하지만 이번 한 번만큼은\n어펜드 카드를 얻어서\n"
	keyWait
		type = 1
	clearMsg
	"한 턴에 바이러스를 삭제해\n보자!\n"
	keyWait
		type = 0
	end
	end
}
script 10 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = OmegaXis
	"어이, 지금은 도망치지 마!\n"
	keyWait
		type = 0
	end
	end
}
script 11 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = OmegaXis
	"아직 카드를 고르지 않았잖아!\n록 버스터만으로는 카운터할\n"
	keyWait
		type = 1
	clearMsg
	"수 없어!\n\n"
	keyWait
		type = 0
	end
	end
}
