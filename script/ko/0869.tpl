@archive 0869
@size 256

script 0 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = MrHertz
	"이봐! 누가 여기에\n낙서를 한 거야!?"
	keyWait
		type = 1
	clearMsg
	"정말이지! 낙서는\n금지되어 있다고!\n"
	keyWait
		type = 1
	clearMsg
	"어디 보자... 뭐라고\n쓰여 있지...?\n"
	keyWait
		type = 1
	clearMsg
	"\"웨이브 친구, 네가 해 준\n모든 일에 고마워!\"\n"
	keyWait
		type = 1
	clearMsg
	"...흠..."
	keyWait
		type = 1
	clearMsg
	"이번만은 못 본 척\n해 주마!\n"
	keyWait
		type = 1
	clearMsg
	"1학년 B반 얘들아,\n계속 열심히 하렴!\n"
	keyWait
		type = 1
	clearMsg
	"내가 지켜보고\n있겠다! *삐 삐*\n"
	keyWait
		type = 0
	end
	end
}
