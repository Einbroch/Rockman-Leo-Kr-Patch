script 50 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = DeliveryNavi
	"어서 오세요! 어서 오세요!\n"
	keyWait
		type = 1
	clearMsg
	"아마켄 기념품점에\n오신 걸 환영합니다!\n"
	keyWait
		type = 1
	clearMsg
	"어이!"
	keyWait
		type = 1
	clearMsg
	"거기 파란 옷 입은 너!\n"
	keyWait
		type = 1
	clearMsg
	"기념품 하나쯤\n사고 싶잖아!\n"
	keyWait
		type = 0
	end
	end
}
