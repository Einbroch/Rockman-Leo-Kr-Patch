@archive 0550
@size 256

script 0 mmsf1 {
	msgOpen
	"책상마다 컴퓨터가\n내장되어 있다.\n"
	keyWait
		type = 1
	clearMsg
	"요즘은 거의 모든 학교에\n이런 게 있다.\n"
	keyWait
		type = 0
	end
	end
}
