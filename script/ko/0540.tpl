script 0 mmsf1 {
	msgOpen
	"엘리베이터 스위치다.\n"
	keyWait
		type = 0
	end
	end
}
script 1 mmsf1 {
	msgOpen
	"모두의 작문이 여기에\n전시되어 있다.\n"
	keyWait
		type = 0
	end
	end
}
script 2 mmsf1 {
	msgOpen
	"디스플레이 스위치를 허락 없이\n건드리면 선생님께서\n"
	keyWait
		type = 1
