script 6 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = Ophiuca
	"그래."
	keyWait
		type = 1
	clearMsg
	"네가 가진\n안드로메다 키 말이야.\n"
	keyWait
		type = 1
	clearMsg
	"우리 함께 사용하는 게\n어때?\n"
	keyWait
		type = 1
	clearMsg
	"우리 둘만으로 이\n행성을 파괴할 수\n있어..."
	keyWait
		type = 1
	clearMsg
	"키 없이는 그게 작동하지\n않는다는 건 너도 잘 알잖아.\n"
	keyWait
		type = 1
	clearMsg
	"작동하려면 두 가지가 필요해.\n네가 가진 키와\n"
	keyWait
		type = 1
	clearMsg
	"FM 왕이 가진\n컨트롤러가 있어야 하지.\n"
	keyWait
		type = 1
	clearMsg
	"나와 손을\n잡는다면,\n"
	keyWait
		type = 1
	clearMsg
	"내가 FM 왕을 홀려서\n그 컨트롤러를\n"
	keyWait
		type = 1
	clearMsg
	"우리에게 넘기게 할 수 있어.\n\n"
	keyWait
		type = 1
	clearMsg
	"그러면 행성 FM의\n최종 파괴 병기,\n"
	keyWait
		type = 1
	clearMsg
	"\"안드로메다\"는\n우리 것이 되는 거야!!\n"
	keyWait
		type = 1
	clearMsg
	jump
		target = 7
	end
}
