script 2 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = Ophiuca
	"드디어 모습을 드러냈구나,\n워록.\n"
	keyWait
		type = 1
	clearMsg
	"수 마일 밖에서도\n이 소녀에게서 나는\n"
	keyWait
		type = 1
	clearMsg
	"네 악취를 맡을 수 있었지.\n\n"
	keyWait
		type = 1
	clearMsg
	"이 아이를 차지하면 네가 숨어\n있을 수 없으리라 생각했는데,\n"
	keyWait
		type = 1
	clearMsg
	"정말로 모습을\n드러냈군!\n"
	keyWait
		type = 1
	clearMsg
	jump
		target = 3
	end
}
