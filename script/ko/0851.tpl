@archive 0851
@size 256

script 0 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = MrHertz
	"호호! 여기는\n교장 선생님 동상의 컴프\n"
	keyWait
		type = 1
	clearMsg
	"스페이스야! 나는 모든 학생과\n코다마 타운 초등학교의\n"
	keyWait
		type = 1
	clearMsg
	"코다마 타운 초등학교에\n방문객이 왔어!\n"
	keyWait
		type = 1
	clearMsg
	"나쁜 짓을 하다 들킨 녀석이\n달아나려 해도\n"
	keyWait
		type = 1
	clearMsg
	"무언가를 훔치려는\n녀석이 있다면\n"
	keyWait
		type = 1
	clearMsg
	"내 눈에서 나오는 빛을\n비춰 주지."
	keyWait
		type = 1
	clearMsg
	"*삐 삐*"
	keyWait
		type = 0
	end
	end
}
