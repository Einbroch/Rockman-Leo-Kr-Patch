@archive 0233
@size 7

script 0 mmsf1 {
	msgOpen
	"이렇게 해서 이번 사건은\n막을 내렸다.\n"
	keyWait
		type = 1
	clearMsg
	"얼마 지나지 않아,\n이번 소동의 원인을 밝히기 위한\n"
	keyWait
		type = 1
	clearMsg
	"조사가\n시작됐다.\n"
	keyWait
		type = 1
	clearMsg
	"스터디 웨이브가\n이쿠타 미치모리 선생님의 정신을\n"
	keyWait
		type = 1
	clearMsg
	"망가뜨렸다는 것이\n사건의 전말로 밝혀졌다.\n"
	keyWait
		type = 1
	clearMsg
	"그 일로 인해 학교에서\n스터디 웨이브를 사용하는 것에\n"
	keyWait
		type = 1
	clearMsg
	"대해 재검토하기 시작했다.\n\n"
	keyWait
		type = 1
	clearMsg
	"이쿠타 미치모리 선생님은\n어떻게 됐어...?"
	keyWait
		type = 1
	clearMsg
	end
}
script 1 mmsf1 {
	msgOpen
	"모든 책임을\n지고\n사임하셨어."
	keyWait
		type = 0
	end
	end
}
script 2 mmsf1 {
	msgOpen
	"\"이쿠타 미치모리 선생님이\n사라지게 될 거야.\"\n"
	keyWait
		type = 1
	clearMsg
	"모두 그렇게\n생각했지만...\n"
	keyWait
		type = 0
	end
	end
}
script 3 mmsf1 {
	msgOpen
	"그 소식을 들은 학생들은\n반대했다.\n"
	keyWait
		type = 1
	clearMsg
	"학생들은 서명을\n모아\n"
	keyWait
		type = 1
	clearMsg
	"교장 선생님께\n탄원서를 제출했다.\n이쿠타 미치모리 선생님을"
	keyWait
		type = 1
	clearMsg
	"코다마 초등학교에\n남겨 달라고 설득하기 위해서였다.\n"
	keyWait
		type = 0
	end
	end
}
script 4 mmsf1 {
	msgOpen
	"그토록 많은 서명을 본\n교장 선생님은\n"
	keyWait
		type = 1
	clearMsg
	"마지못해 결국\n요구를 받아들였다.\n"
	keyWait
		type = 0
	end
	end
}
script 5 mmsf1 {
	msgOpen
	"그렇게 이쿠타 미치모리 선생님은\n예전처럼 계속\n"
	keyWait
		type = 1
	clearMsg
	"교사로 일할 수 있게\n되었다.\n"
	keyWait
		type = 0
	end
	end
}
script 6 mmsf1 {
	msgOpen
	"그리고 며칠 후...\n"
	keyWait
		type = 1
	clearMsg
	"학교 행사가 열리는\n날이었다.\n"
	keyWait
		type = 0
	end
	end
}
