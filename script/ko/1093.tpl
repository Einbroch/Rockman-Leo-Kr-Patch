@archive 1093
@size 256

script 50 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = InfoNavi
	"저기 저 행성을\n봐."
	keyWait
		type = 1
	clearMsg
	"저 고리들은 대체\n뭘까?"
	keyWait
		type = 1
	clearMsg
	"도넛일까?"
	keyWait
		type = 1
	clearMsg
	"도넛이라면 엄청난\n양의 밀가루를\n썼겠지,"
	keyWait
		type = 1
	clearMsg
	"유통기한 안에\n먹어야겠네.\n"
	keyWait
		type = 1
	clearMsg
	"뭐!?"
	keyWait
		type = 1
	clearMsg
	"이런 무례한 녀석! 내비 하나가\n그런 도넛을 어떻게 먹겠어!!\n"
	keyWait
		type = 1
	clearMsg
	"흠…"
	keyWait
		type = 1
	clearMsg
	"도넛 하나를 먹으려면 내비가\n몇 명이나 필요할까?\n"
	keyWait
		type = 0
	end
	end
}
