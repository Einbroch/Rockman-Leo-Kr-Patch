@archive 0328
@size 1

script 0 mmsf1 {
	msgOpen
	"옥스, 키그너스, 하프,\n리브라…\n"
	keyWait
		type = 1
	clearMsg
	"오퓨커스, 제미니…\n\n"
	keyWait
		type = 1
	clearMsg
	"너희는 나의 최강 전사로\n파견되었건만,\n"
	keyWait
		type = 1
	clearMsg
	"나를 실망시키고 말았구나.\n처참할 정도로 말이지.\n"
	keyWait
		type = 1
	clearMsg
	"게다가 하프는 감히 나를\n배신하기까지 했지…\n"
	keyWait
		type = 1
	clearMsg
	"역시 내가 믿을 수 있는 건\n나 자신뿐이야.\n"
	keyWait
		type = 1
	clearMsg
	"두고 보자,\n워록…\n"
	keyWait
		type = 1
	clearMsg
	"그리고 너도 말이야,\n꼬마 지구인.\n"
	keyWait
		type = 1
	clearMsg
	"이 FM 왕인 내가 직접 지구를\n\n"
	keyWait
		type = 1
	clearMsg
	"파멸과 절망의 행성으로\n바꿔 주마.\n"
	keyWait
		type = 1
	clearMsg
	"AM 행성에 그랬던 것처럼\n말이지!!\n"
	keyWait
		type = 1
	clearMsg
	"안드로메다여, 다시 한번 네\n힘을 빌려다오…\n"
	keyWait
		type = 0
	end
	end
}
