script 50 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = FighterNavi
	"나는 에코 초등학교의\n보안 내비입니다.\n"
	keyWait
		type = 1
	clearMsg
	"얼마 전 시설을\n파손한 사건이 일어난 뒤\n"
	keyWait
		type = 1
	clearMsg
	"이곳에 배치됐습니다. 수상한\n사람을 보시면\n"
	keyWait
		type = 1
	clearMsg
	"반드시 저에게\n알려 주세요!\n"
	keyWait
		type = 0
	end
	end
}
