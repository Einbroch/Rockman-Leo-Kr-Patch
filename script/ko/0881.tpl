@archive 0881
@size 256

script 0 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = MrHertz
	"5학년 아이들은 정말\n똑 부러진 것 같아.\n"
	keyWait
		type = 1
	clearMsg
	"나도 그래야\n하는데!\n"
	keyWait
		type = 1
	clearMsg
	"하지만 내가 할 수 있는 일은\n정말 별로 없어. 아,\n"
	keyWait
		type = 1
	clearMsg
	"나도 반장 같은 걸\n해 보고 싶다!\n"
	keyWait
		type = 0
	end
	end
}
