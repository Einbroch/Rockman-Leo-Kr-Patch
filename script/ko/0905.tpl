@archive 0905
@size 256

script 0 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = MrHertz
	"어머! 그 파란 슈트,\n정말 멋지게 어울리는걸!\n"
	keyWait
		type = 1
	clearMsg
	"자기야,*삐* 얌전히 있어!\n"
	keyWait
		type = 1
	clearMsg
	"하지만 딱 하나\n빠진 게 있네...\n"
	keyWait
		type = 1
	clearMsg
	"대담함!"
	keyWait
		type = 1
	clearMsg
	"있잖아, 네 \"자아\"도\n빨간색으로 꾸며\n보는 게"
	keyWait
		type = 1
	clearMsg
	"어때? 내가 가르쳐\n줄까?\n"
	keyWait
		type = 1
	clearMsg
	"뭐? 지금은 안 된다고?"
	keyWait
		type = 1
	clearMsg
	"아, 아쉽네."
	keyWait
		type = 1
	clearMsg
	"*삐삐*"
	keyWait
		type = 0
	end
	end
}
