@archive 0016
@size 30

script 0 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = OmegaXis
	"이 카드들은... 음, 됐어.\n먼저\n"
	keyWait
		type = 1
	clearMsg
	"흰색 배틀 카드부터 설명할게.\n\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = MegaMan
	"흰색 카드?"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = OmegaXis
	"커스텀 화면을\n잘 봐.\n"
	keyWait
		type = 0
	end
	end
}
script 1 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = OmegaXis
	"흰색 배틀 카드는 아주\n유용한 녀석들이야.\n"
	keyWait
		type = 1
	clearMsg
	"어디에 있든 상관없이\n다른 카드와\n"
	keyWait
		type = 1
	clearMsg
	"짝지을 수 있어. 종류가\n달라도 말이지!\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = MegaMan
	"정말? 그럼\n조합하기 쉽겠네.\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = OmegaXis
	"그래. 예를 들어,\n\n"
	keyWait
		type = 1
	clearMsg
	"이 넓은 범위 공격인\n에어 스프레드를 보자...\n"
	keyWait
		type = 0
	end
	end
}
script 2 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = OmegaXis
	"공격력 +10 카드를\n골라서\n"
	keyWait
		type = 0
	end
	"카드의 공격력에\n10을 더해 봐.\n"
	keyWait
		type = 1
	clearMsg
	end
}
script 3 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = OmegaXis
	"에어 스프레드는 한 번 공격할 때\n3번 명중하니까,\n"
	keyWait
		type = 1
	clearMsg
	"이 두 카드는 궁합이 아주 좋아.\n게다가\n"
	keyWait
		type = 1
	clearMsg
	"바로 아래 있는 소드 카드도\n고를 수 있어.\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = MegaMan
	"흠, 이 콤보 규칙을\n한번 써 봐야겠다!\n"
	keyWait
		type = 0
	end
	end
}
script 4 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = OmegaXis
	"좋아. 그럼 뭘\n기다려!?\n"
	keyWait
		type = 0
	end
	end
}
script 10 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = OmegaXis
	"자, 꼬마야.\n우리의 특수 콤보 공격이야!\n"
	keyWait
		type = 1
	clearMsg
	"워록 어택에 대해\n설명해 줄게.\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = MegaMan
	"워록 어택!?"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = OmegaXis
	"잘 들어! 소드는\n바로 앞 한 칸만\n공격해서,"
	keyWait
		type = 1
	clearMsg
	"적을 공격할 수\n없어.\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = MegaMan
	"그럼 어떻게 해야\n해?"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = OmegaXis
	"그럴 때 워록\n어택이 유용하지!\n"
	keyWait
		type = 1
	clearMsg
	"먼저 에어 스프레드로 앞에\n있는 두 녀석을 처리하고,\n"
	keyWait
		type = 1
	clearMsg
	"그다음 소드\n카드를 쓰기\n전에"
	keyWait
		type = 1
	clearMsg
	"아래 방향키를 눌러.\n\n"
	keyWait
		type = 1
	clearMsg
	"그러면 내가 적을\n록온할 거야.\n"
	keyWait
		type = 1
	clearMsg
	"록온하면 우리 앞이나\n대각선에 있는 적에게\n"
	keyWait
		type = 1
	clearMsg
	"조준 표시가\n나타나.\n"
	keyWait
		type = 1
	clearMsg
	"그 표시가 보이면\n소드 카드를 써!\n"
	keyWait
		type = 1
	clearMsg
	"적에게 단숨에 돌진해서\n두 동강 내 주마!\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = MegaMan
	"알겠어... 소드 카드를\n쓰기 전에\n"
	keyWait
		type = 1
	clearMsg
	"아래 방향키를 누른다.\n\n"
	keyWait
		type = 1
	clearMsg
	"조준 표시가 나타나면\n소드 카드를 쓴다!\n"
	keyWait
		type = 0
	end
	"좋아! 워록 어택을\n시험해 보자!\n"
	keyWait
		type = 1
	clearMsg
	end
}
