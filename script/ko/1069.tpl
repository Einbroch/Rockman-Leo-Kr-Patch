@archive 1069
@size 256

script 50 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = MrHertz
	"*삐삐*"
	keyWait
		type = 1
	clearMsg
	"나는 미스터 허츠야. 이 연구소\n데이터 파일 운반을 맡고 있지.\n"
	keyWait
		type = 1
	clearMsg
	"미스터 허츠야.\n아, 정말 궁금해!\n"
	keyWait
		type = 1
	clearMsg
	"이 일급비밀 문서 안에는\n뭐가 들어 있을까?\n"
	keyWait
		type = 1
	clearMsg
	"너무 궁금해서 움직일 수가\n없을 정도야!! *삐삐*\n"
	keyWait
		type = 0
	end
	end
}
script 51 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = MrHertz
	"오른쪽, 이상 없음!\n"
	keyWait
		type = 1
	clearMsg
	"왼쪽, 이상 없음!\n"
	keyWait
		type = 1
	clearMsg
	"*삐삐!?*"
	keyWait
		type = 1
	clearMsg
	"거기 너! 이름과\n용건을 밝혀라!\n"
	keyWait
		type = 1
	clearMsg
	"어라? 전파가 아니야?\n인간이라고?\n"
	keyWait
		type = 1
	clearMsg
	"흠…"
	keyWait
		type = 1
	clearMsg
	"허가받지 않은 전파는\n모두 제거해야 하지만,\n"
	keyWait
		type = 1
	clearMsg
	"인간은 어떻게 해야 할지\n모르겠군…\n"
	keyWait
		type = 1
	clearMsg
	"흠…"
	keyWait
		type = 0
	end
	end
}
script 52 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = DeliveryNavi
	"후…"
	keyWait
		type = 1
	clearMsg
	"음?"
	keyWait
		type = 1
	clearMsg
	"처음 보는 얼굴이군.\n여기는 아마켄의 전파고,\n"
	keyWait
		type = 1
	clearMsg
	"나는 옆 마을에서 데이터를\n배달하고 있어!\n"
	keyWait
		type = 0
	end
	end
}
