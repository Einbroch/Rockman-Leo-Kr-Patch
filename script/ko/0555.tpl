@archive 0555
@size 256

script 0 mmsf1 {
	msgOpen
	"책상마다\n컴퓨터가 내장돼 있다.\n"
	keyWait
		type = 1
	clearMsg
	"요즘은 거의 모든 학교에\n이런 책상이 있다.\n"
	keyWait
		type = 0
	end
	end
}
