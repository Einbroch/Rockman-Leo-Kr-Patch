@archive 1124
@size 256

script 50 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = MrHertz
	"난 항상 여기 앉아서\n수업을 듣고 있어.\n"
	keyWait
		type = 1
	clearMsg
	"셰퍼 선생님은 정말\n훌륭한 선생님이야!\n"
	keyWait
		type = 1
	clearMsg
	"언제나 학생들을\n먼저 생각하시거든.\n"
	keyWait
		type = 1
	clearMsg
	"*삐삐*"
	keyWait
		type = 0
	end
	end
}
script 51 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = MrHertz
	"대체 무슨 일이야!?\n"
	keyWait
		type = 1
	clearMsg
	"셰퍼 선생님은 저렇게\n난폭한 분이 아니신데! 그리고\n"
	keyWait
		type = 1
	clearMsg
	"선생님 머리 위에서\n처음 보는 전파가\n"
	keyWait
		type = 1
	clearMsg
	"떠 있었어! 저 전파가\n선생님을 저렇게 만든 걸까?\n"
	keyWait
		type = 0
	end
	end
}
