script 0 mmsf1 {
	msgOpenQuick
	mugshotHide
	textSpeed
		delay = 3
	"이번 주에는\n트랜서를 배웠습니다."
	keyWait
		type = 1
	clearMsg
	"트랜서는 모두가 팔에 착용하는\n휴대 단말기입니다.\n"
	keyWait
		type = 1
	clearMsg
	"팔에 착용합니다. 이메일과\n전화 등 다양한\n"
	keyWait
		type = 1
	clearMsg
	"기능이\n있으며,\n"
	keyWait
		type = 1
	clearMsg
	"퍼스널 페이지와 기타 정보도\n저장합니다.\n"
	keyWait
		type = 1
	clearMsg
	"SELECT 버튼을\n누르면\n"
	keyWait
		type = 1
	clearMsg
	"트랜서의 여러\n화면을\n"
	keyWait
		type = 1
	clearMsg
	"전환해 퍼스널\n카드,\n"
	keyWait
		type = 1
	clearMsg
	"브라더 카드, 내비 카드 등을\n확인할 수 있습니다.\n"
	keyWait
		type = 1
	clearMsg
	"트랜서에 내비 카드가\n표시되고 있다면,"
	keyWait
		type = 1
	clearMsg
	"현재 그 내비가 트랜서에\n들어 있다는 뜻입니다."
	keyWait
		type = 1
	clearMsg
	"내비 카드를\n트랜서에\n"
	keyWait
		type = 1
	clearMsg
	"통과시키면 놀라운 힘이\n발동합니다."
	keyWait
		type = 1
	clearMsg
	"내비는 없어서는 안 될\n친구이니, 가끔은"
	keyWait
		type = 1
	clearMsg
	"L로 말을 걸어\n보세요!\n"
	keyWait
		type = 1
	clearMsg
	"마지막으로\n모든 트랜서는\n"
	keyWait
		type = 1
	clearMsg
	"우주에 있는 위성 3개 중\n하나에 등록됩니다:\n"
	keyWait
		type = 1
	clearMsg
	"페가수스, 레오, 드래곤입니다.\n"
	keyWait
		type = 1
	clearMsg
	"이 위성들 덕분에 같은\n위성에 등록된"
	keyWait
		type = 1
	clearMsg
	"트랜서끼리는 서로 통신할 수\n있습니다.\n"
	keyWait
		type = 1
	clearMsg
	"또한 현대 시대의\n상징이라 할\n"
	keyWait
		type = 1
	clearMsg
