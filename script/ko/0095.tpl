script 5 mmsf1 {
	msgOpenQuick
	mugshotShow
		mugshot = PegasusMagicShadow
	textSpeed
		delay = 3
	"스타 포스 사용법을\n복습하겠습니다.\n"
	keyWait
		type = 1
	clearMsg
	"커스텀 화면에서 폴더에 넣은\n스타 포스\n"
	keyWait
		type = 1
	clearMsg
	"카드를 선택하면,\n곧바로\n"
	keyWait
		type = 1
	clearMsg
	"아이스 페가수스 록맨으로\n변신합니다.\n"
	keyWait
		type = 1
	clearMsg
	"페가수스 이외의\n위성에 등록된\n"
	keyWait
		type = 1
	clearMsg
	"브라더가\n있다면,\n"
	keyWait
		type = 1
	clearMsg
	"그 브라더의 스타 포스를\n사용할 수도 있습니다.\n"
	keyWait
		type = 1
	clearMsg
	"아이스 페가수스\n록맨은\n"
	keyWait
		type = 1
	clearMsg
	"아쿠아의\n힘을 얻어\n"
	keyWait
		type = 1
	clearMsg
	"적을 아이스 슬래시로 공격할 수\n있습니다. 하지만\n"
	keyWait
		type = 1
	clearMsg
	"일렉 공격을 받으면 피해가\n두 배가 되고\n"
	keyWait
		type = 1
	clearMsg
	"록맨으로\n돌아옵니다.\n"
	keyWait
		type = 1
	clearMsg
	"변신 중에는 선택할\n수 있는\n"
	keyWait
		type = 1
	clearMsg
	"카드의 수가 늘어납니다.\n\n"
	keyWait
		type = 1
	clearMsg
	"이제 같은 열의 카드로\n제한되지 않고,\n"
	keyWait
		type = 1
	clearMsg
	"같은 행의 카드도 선택할 수\n있습니다.\n"
	keyWait
		type = 1
	clearMsg
	"한 가지 더 있습니다. 보통\n카운터를\n"
	keyWait
		type = 1
	clearMsg
	"성공시키면 어펜드 카드가\n나타납니다.\n"
	keyWait
		type = 1
	clearMsg
	"하지만 변신\n중에는 이것이\n"
	keyWait
		type = 1
	clearMsg
	"스타 포스 빅뱅, 줄여서 SFB로\n바뀝니다.\n"
	keyWait
		type = 1
	clearMsg
	"아이스 페가수스의 SFB는\n매지션즈 프리즈입니다! 이는\n"
	keyWait
		type = 1
	clearMsg
	"거대한 마법진에서\n적을 향해\n"
	keyWait
		type = 1
	clearMsg
	"얼음 가시를 쏘아 올리는\n공격입니다.\n"
	keyWait
		type = 1
	clearMsg
	"페가수스 스타 포스를 잘\n사용하면,\n"
	keyWait
		type = 1
	clearMsg
	"소중한 사람들을 지키는 데\n도움이 될 것입니다."
	keyWait
		type = 2
	waitHold
	end
}
