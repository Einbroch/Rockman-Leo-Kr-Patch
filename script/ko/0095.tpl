	keyWait
		type = 2
	waitHold
	end
}
script 1 mmsf1 {
	msgOpenQuick
	mugshotShow
		mugshot = Luna
	textSpeed
		delay = 3
	"안녕, "
	printPlayerName1
	"!"
	keyWait
		type = 1
	clearMsg
	"반장인 시로가네\n루나야.\n"
	keyWait
		type = 1
	clearMsg
	"방금 한\n내용을\n"
	keyWait
		type = 1
	clearMsg
	"숙제로 복습해 보자.\n브라더 밴드는\n"
	keyWait
		type = 1
	clearMsg
	"전파를 통해 두 친구를\n연결하는 시스템이야.\n"
	keyWait
		type = 1
	clearMsg
	"누군가와 브라더가\n되면\n"
	keyWait
		type = 1
	clearMsg
	"어디에 있든 이메일과 데이터를\n주고받고, 서로의\n"
	keyWait
		type = 1
	clearMsg
	"퍼스널 페이지도\n볼 수 있어!\n"
	keyWait
		type = 1
	clearMsg
	"퍼스널 페이지에는\n프로필과 즐겨찾기\n"
	keyWait
		type = 1
	clearMsg
	"배틀 카드 같은 정보가\n표시돼.\n"
	keyWait
		type = 1
	clearMsg
	"브라더 밴드를\n맺으려면\n"
	keyWait
		type = 1
	clearMsg
	"퍼스널 페이지가\n꼭 필요해.\n"
	keyWait
		type = 1
	clearMsg
	"그럼 이제 네 페이지에\n뭐가 있는지 살펴보자.\n"
	keyWait
		type = 1
	clearMsg
	"먼저 얼굴 아이콘과\n이름, 레벨이 표시돼.\n"
	keyWait
		type = 1
	clearMsg
	"그 아래에는 배틀 데이터가\n표시돼.\n"
	keyWait
		type = 1
	clearMsg
	"즐겨찾기 칸에는 네가\n고른 카드 6장이"
	keyWait
		type = 1
	clearMsg
	"표시돼. 즐겨찾기로\n지정한 카드는\n"
	keyWait
		type = 1
	clearMsg
	"브라더도 사용할 수\n있으니까,\n"
	keyWait
		type = 1
	clearMsg
	"강한 카드로\n골라 둬!\n"
	keyWait
		type = 1
	clearMsg
	"어디 보자…\n베스트 콤보…"
	wait
		frames = 16
	"\n"
	keyWait
		type = 1
	clearMsg
	"그건 사실 잘\n모르겠는데…\n"
	keyWait
		type = 1
	clearMsg
	"지금은 어차피 필요\n없으니까.\n"
	keyWait
		type = 1
	clearMsg
	"링크 어빌리티는\n너와 브라더가\n"
	keyWait
		type = 1
	clearMsg
	"서로에게 주는 강화\n효과야!\n"
	keyWait
		type = 1
	clearMsg
	"마지막은 메시지와 시크릿이야!\n\n"
	keyWait
		type = 1
	clearMsg
	"메시지는 브라더에게 보내는\n쪽지야.\n"
	keyWait
		type = 1
	clearMsg
	"최근에 한\n일이나,\n"
	keyWait
		type = 1
	clearMsg
	"자랑하고 싶은 일 등 뭐든지 써도\n돼!\n\n"
	keyWait
		type = 1
	clearMsg
	"시크릿은 말 그대로 비밀이야.\n남에게는 말할 수 없지만\n"
	keyWait
		type = 1
	clearMsg
	"브라더에게는 말할 수 있는\n이야기지!\n"
	keyWait
		type = 1
	clearMsg
	"누군가와 브라더가\n되면,\n"
	keyWait
		type = 1
	clearMsg
	"그 사람이 네 시크릿을 볼 수\n있어. 그러니 솔직해야 해!\n"
	keyWait
		type = 1
	clearMsg
	"퍼스널 페이지 설명은 여기까지야!\n그런데 말이야…\n"
	keyWait
		type = 1
	clearMsg
	"현실의 친구가 있고\n그 친구들과\n"
	keyWait
		type = 1
	clearMsg
	"브라더 밴드를 맺고 싶다면,\n처음에는\n"
	keyWait
		type = 1
	clearMsg
	"리얼 브라더는 3명까지만\n맺을 수 있어. 하지만…\n"
	keyWait
		type = 1
	clearMsg
	"언젠가 네가 대단한 일을\n해낸다면,\n"
	keyWait
		type = 1
	clearMsg
	"가질 수 있는 브라더의 수가\n늘어날 거야!\n"
	keyWait
		type = 1
	clearMsg
	"그럼 학교에서 보자!\n"
	keyWait
		type = 2
	waitHold
	end
}
