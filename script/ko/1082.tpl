@archive 1082
@size 256

script 10 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = MegaMan
	"웨이브 볼이다! 좋아,\n어서 처리하러 가자!\n"
	keyWait
		type = 1
	clearMsg
	"핫!!"
	keyWait
		type = 2
	flagSet
		flag = 1082
	end
}
script 11 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = OmegaXis
	"이 지역의 웨이브 볼은\n전부 처리한 것 같아.\n"
	keyWait
		type = 0
	end
	end
}
script 50 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = InfoNavi
	"블랙홀은 뭐든\n빨아들인다는데...\n"
	keyWait
		type = 1
	clearMsg
	"흠, 그 중심에 정말\n배고픈 괴물이\n"
	keyWait
		type = 1
	clearMsg
	"숨어 있는 건\n아닐까...\n"
	keyWait
		type = 1
	clearMsg
	"정말 뭐든지\n먹어 치우는 걸까...?\n"
	keyWait
		type = 0
	end
	end
}
script 70 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = InfoNavi
	"근처에서 아주 불길한\n웨이브가 느껴져.\n"
	keyWait
		type = 1
	clearMsg
	"저, 저건 블랙홀 장치를\n사용하고 있어...\n"
	keyWait
		type = 0
	end
	end
}
script 90 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = InfoNavi
	"여기 직원들에게\n물어보고 싶은 게 있었는데,\n"
	keyWait
		type = 1
	clearMsg
	"은하가 있는 곳이라면\n어디든\n"
	keyWait
		type = 1
	clearMsg
	"블랙홀이 있는 것\n같아.\n"
	keyWait
		type = 1
	clearMsg
	"내 이론이 맞다면,\n각 블랙홀 안에는\n"
	keyWait
		type = 1
	clearMsg
	"크고 배고픈 괴물이\n살고 있는 셈이지.\n"
	keyWait
		type = 1
	clearMsg
	"아, 생각만 해도\n소름이 돋아.\n"
	keyWait
		type = 0
	end
	end
}
script 150 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = InfoNavi
	"로켓을 보면 그것도\n생각나지...\n"
	keyWait
		type = 1
	clearMsg
	"너는 정말 속마음이 다 보인다니까...\n"
	keyWait
		type = 1
	clearMsg
	"그런데 내가 바라보면,\n"
	keyWait
		type = 1
	clearMsg
	"난 그냥 녹아 버려...\n"
	keyWait
		type = 0
	end
	end
}
script 151 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = MrHertz
	"여기 물건이 전부\n파괴된 줄 알았어.\n"
	keyWait
		type = 1
	clearMsg
	"최근 음악 사고 때\n말이야!\n"
	keyWait
		type = 1
	clearMsg
	"기계 애호가인\n나는 며칠 밤이나 잠을 못\n잤다고!"
	keyWait
		type = 1
	clearMsg
	"그래도 크게 다친 사람이\n없어서 정말 다행이야!\n"
	keyWait
		type = 0
	end
	end
}
