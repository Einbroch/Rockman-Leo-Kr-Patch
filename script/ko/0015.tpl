@archive 0015
@size 30

script 0 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = OmegaXis
	"전파 세계에서는\n웨이브 배틀을 해.\n"
	keyWait
		type = 1
	clearMsg
	"자, 꼬마야. 입 다물고\n잘 배워.\n"
	keyWait
		type = 0
	end
	end
}
script 1 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = OmegaXis
	"이게 커스텀 화면이야."
	keyWait
		type = 1
	clearMsg
	"여기에는 30장의 배틀 카드\n중 6장이 표시돼.\n"
	keyWait
		type = 1
	clearMsg
	"이 중에서 사용할\n카드를 고를 수 있어.\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = MegaMan
	"그럼 6장 전부 고르면 되는\n거지?\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = OmegaXis
	"마음껏 고르는 뷔페가\n아니라고!\n"
	keyWait
		type = 1
	clearMsg
	"지켜야 할\n규칙이 있단 말이야!\n"
	keyWait
		type = 1
	clearMsg
	"먼저, 같은 세로줄에\n있는 카드는\n"
	keyWait
		type = 1
	clearMsg
	"같은 턴에 고를 수 있어.\n\n"
	keyWait
		type = 0
	end
	end
}
script 2 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = OmegaXis
	"다음으로, 같은 카드는\n"
	keyWait
		type = 1
	clearMsg
	"어디에 배치되어 있든 고를\n수 있어.\n"
	keyWait
		type = 0
	end
	end
}
script 3 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = OmegaXis
	"어떤 카드가 효과적인지\n생각해서 신중하게\n골라."
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = MegaMan
	"「신중하게\n고르라」고? 뭘 써야 할지\n모르겠는데.\n"
	keyWait
		type = 1
	clearMsg
	"카드는 갖고 있어도 제대로\n써 본 적이 없어.\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = OmegaXis
	"진정해. 배틀 카드에 대한\n설명은\n"
	keyWait
		type = 1
	clearMsg
	"R 버튼을 누르면 읽을 수 있어.\n\n"
	keyWait
		type = 1
	clearMsg
	"그리고 정말 까다로운 적을\n만나면\n"
	keyWait
		type = 1
	clearMsg
	"L 버튼을 눌러 도망칠\n수도 있어.\n"
	keyWait
		type = 1
	clearMsg
	"하지만 성공할지는\n운에 달렸지.\n"
	keyWait
		type = 1
	clearMsg
	"하하하.\n\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = MegaMan
	"역시 그냥 되는 건 아니구나.\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = OmegaXis
	"좋아, 이제 실력을\n보여 줘.\n"
	keyWait
		type = 1
	clearMsg
	"카드를 골라, 꼬마야.\n\n"
	keyWait
		type = 0
	end
	end
}
script 4 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = OmegaXis
	"좋아, 이제 OK 버튼을\n눌러."
	keyWait
		type = 1
	clearMsg
	end
}
script 10 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = OmegaXis
	"드디어다! 카드로\n놈들을 박살 내자!\n"
	keyWait
		type = 1
	clearMsg
	"네가 고른 카드는\n오른쪽 아래에 있어.\n"
	keyWait
		type = 0
	end
	end
}
script 11 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = OmegaXis
	"이건 다음 카드의\n이름과 공격력이야.\n"
	keyWait
		type = 0
	end
	end
}
script 12 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = OmegaXis
	"배틀 카드를 사용하려면\nA 버튼을 누르고,\n"
	keyWait
		type = 1
	clearMsg
	"록 버스터를 연속으로\n쏘려면\n"
	keyWait
		type = 1
	clearMsg
	"B를 계속 누르고 있어!\n\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = MegaMan
	"좋아, 싸우는 법은 알겠어.\n그런데 체력은 어떻게 해?\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = OmegaXis
	"왼쪽 위에 있잖아.\n이 숫자가 네\n"
	keyWait
		type = 1
	clearMsg
	"히트 포인트(HP), 즉\n체력을 나타내는 수치야.\n"
	keyWait
		type = 0
	end
	end
}
script 13 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = OmegaXis
	"이게 0이 되면 끝장이야.\n알겠지, 꼬마야?\n"
	keyWait
		type = 1
	clearMsg
	"방향키로 좌우로\n이동해서\n"
	keyWait
		type = 1
	clearMsg
	"적의 공격을 피할 수 있어.\n\n"
	keyWait
		type = 1
	clearMsg
	"그럼 이제 싸우러 가자,\n파트너!\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = MegaMan
	"잠깐! 적을 다 쓰러뜨리기 전에\n카드를\n"
	keyWait
		type = 1
	clearMsg
	"전부 써 버리면 어떻게\n해?\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = OmegaXis
	"참 성가신 녀석이군.\n여길 봐.\n"
	keyWait
		type = 0
	end
	end
}
script 14 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = OmegaXis
	"이건 커스텀 게이지야.\n\n"
	keyWait
		type = 1
	clearMsg
	"시간이 지나면 자동으로\n차오르지.\n"
	keyWait
		type = 1
	clearMsg
	"가득 찼을 때 L이나 R 버튼을\n누르면\n"
	keyWait
		type = 1
	clearMsg
	"다시 커스텀 화면으로\n들어가게 돼.\n"
	keyWait
		type = 1
	clearMsg
	"좋아, 이제 준비는\n끝났으니 가자!\n"
	keyWait
		type = 1
	clearMsg
	mugshotShow
		mugshot = MegaMan
	"아, 알았어!"
	keyWait
		type = 0
	end
	end
}
script 20 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = OmegaXis
	"어이! 그걸 고르면 그\n카드만 쓸 수 있어!\n"
	keyWait
		type = 0
	end
	end
}
