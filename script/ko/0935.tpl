@archive 0935
@size 256

script 0 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = MrHertz
	"멍멍! *삐삐*\n"
	keyWait
		type = 1
	clearMsg
	"나는 경비견 전파야!\n멍멍!\n"
	keyWait
		type = 1
	clearMsg
	"하지만 오늘날처럼 평화롭고\n안전한 사회에서는\n"
	keyWait
		type = 1
	clearMsg
	"내 도움이 딱히 필요하지\n않아.\n"
	keyWait
		type = 1
	clearMsg
	"그래도 괜찮아!"
	keyWait
		type = 1
	clearMsg
	"사람들이 가끔 나를 한 번씩\n보고 옛날의 험난했던 시절을\n"
	keyWait
		type = 1
	clearMsg
	"기억해 주기만\n해도 만족해!\n"
	keyWait
		type = 1
	clearMsg
	"멍멍! *삐삐*\n"
	keyWait
		type = 0
	end
	end
}
