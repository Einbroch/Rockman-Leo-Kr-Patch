@archive 0797
@size 256

script 0 mmsf1 {
	msgOpen
	mugshotShow
		mugshot = MrHertz
	"*삐 삐*"
	keyWait
		type = 1
	clearMsg
	"아름다움을 만드는 게\n뭔지 알아? 바로 그거야!\n"
	keyWait
		type = 1
	clearMsg
	"화장!"
	keyWait
		type = 1
	clearMsg
	"아름다움은\n화장에서 시작되지!\n"
	keyWait
		type = 1
	clearMsg
	"아무리 슬퍼 보이는\n얼굴이라도,\n"
	keyWait
		type = 1
	clearMsg
	"나처럼 행복한\n허츠 씨와\n"
	keyWait
		type = 1
	clearMsg
	"완전 자동 전파 화장\n시스템만 있으면\n"
	keyWait
		type = 1
	clearMsg
	"스타처럼 보이게 만들어\n줄게!\n"
	keyWait
		type = 1
	clearMsg
	"*삐 삐*"
	keyWait
		type = 0
	end
	end
}
