<Project Sdk="Microsoft.NET.Sdk">
  <!-- 원본 LibTextPet.csproj(.NET Framework 4.8.1)를 대신하는 .NET 8용 프로젝트. build.sh 가 work/textpet/build/ 로 복사해서 쓴다. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0618;CA1416;CA2013;SYSLIB0011;SYSLIB0051</NoWarn>
    <TextPetSrc>$(MSBuildThisFileDirectory)../../src</TextPetSrc>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(TextPetSrc)/LibTextPet/**/*.cs" Exclude="$(TextPetSrc)/LibTextPet/obj/**;$(TextPetSrc)/LibTextPet/bin/**" />
    <EmbeddedResource Include="$(TextPetSrc)/LibTextPet/Plugins/BuiltIn/bool.ini" LogicalName="LibTextPet.Plugins.BuiltIn.bool.ini" />
  </ItemGroup>
</Project>
